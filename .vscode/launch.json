{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Astro Dev Server",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/web"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Development Debug",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./src-tauri/Cargo.toml",
          "--no-default-features"
        ]
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Production Debug",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=./src-tauri/Cargo.toml"
        ]
      }
    },
    {
      "name": "Launch native via Bun",
      "request": "launch",
      "runtimeArgs": [
        "run",
        "tauri:dev"
      ],
      "runtimeExecutable": "bun",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    }
  ]
}
